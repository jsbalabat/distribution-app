rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if user is admin
    function isAdmin() {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if user owns the document
    function isOwner(userIdField) {
      return request.auth.uid == resource.data[userIdField];
    }

    // users collection
    // - Users can read and write their own data
    // - Admins can read and update any user (needed for role management)
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // companyTenants collection
    // - readable so clients can resolve company identifier before sign-in
    // - writable by admins only
    match /companyTenants/{companyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // salesRequisitions collection
    // - Created ONLY by the submitSalesRequisition callable, and item/amount
    //   edits go ONLY through the editSalesRequisition callable (Admin SDK
    //   bypasses rules), so the server owns numbering, inventory and routing.
    // - Owners read their own, admins read all. The only direct client write
    //   left is the archive soft-delete, so update is restricted to its fields;
    //   hard delete is denied.
    match /salesRequisitions/{sorId} {
      allow create: if false;
      allow read: if isSignedIn() && (isOwner("userID") || isAdmin());
      allow update: if isSignedIn() && (isOwner("userID") || isAdmin())
        && request.resource.data.diff(resource.data).changedKeys()
             .hasOnly(['isDeleted', 'deletedAt', 'deletedBy', 'deletedByEmail', 'updatedAt']);
      allow delete: if false;
    }

    // dataImports collection
    // - Only admins can create import requests
    // - Only admins can read import status
    match /dataImports/{docId} {
      allow create, read, write: if isAdmin();
    }

    // customers collection
    // - All authenticated users can read (for form dropdowns)
    // - Only admins can write
    match /customers/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // accountReceivable collection
    // - All authenticated users can read
    // - Only admins can write
    match /accountReceivable/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // itemMaster collection
    // - All authenticated users can read (for price lookups)
    // - Only admins can write
    match /itemMaster/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // items collection
    // - All authenticated users can read
    // - Only admins can write
    match /items/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // itemsAvailable collection
    // - All authenticated users can read (for inventory checks)
    // - Stock is written ONLY by the server — the submit callable decrements it
    //   and the Excel import seeds it, both via the Admin SDK (bypasses rules).
    //   The old signed-in client-decrement allowance is gone now the callable
    //   owns inventory writes.
    match /itemsAvailable/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Admin-only collections
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }

    // Settings collection
    // - Only admins can read and write settings
    match /settings/{docId} {
      allow read, write: if isAdmin();
    }

    // auditLogs collection
    // - Any signed-in user can create logs for their own actor UID
    // - Only admins can read/update/delete logs
    match /auditLogs/{logId} {
      allow create: if isSignedIn()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.timestamp == request.time;
      allow read, update, delete: if isAdmin();
    }

    // notifications collection
    // - Signed-in users can create notifications they author
    // - Users can read notifications targeted to them
    // - Admins can read/admin notifications and manage read state
    match /notifications/{notificationId} {
      allow create: if isSignedIn()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin()
        || request.auth.uid == resource.data.recipientUid
        || (resource.data.targetRole == 'admin' && isAdmin());
      allow update: if isAdmin()
        || request.auth.uid == resource.data.recipientUid;
      allow delete: if isAdmin();
    }

    // counters collection
    // - SOR numbers are allocated server-side by the submitSalesRequisition
    //   callable (Admin SDK, which bypasses rules); no client reads or writes
    //   these, so both are denied to keep numbering tamper-proof.
    match /counters/{counterId} {
      allow read, write: if false;
    }

    // Catch-all (default deny for security)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
